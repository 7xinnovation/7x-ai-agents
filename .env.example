# Neon Postgres (pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Anthropic via Azure AI Foundry (native Anthropic Messages API passthrough).
# When set, all Claude traffic routes through Azure (baseURL ends in /anthropic).
AZURE_ANTHROPIC_ENDPOINT="https://<resource>.services.ai.azure.com/anthropic"
AZURE_ANTHROPIC_API_KEY="<azure-ai-foundry-key>"
# Direct Anthropic fallback (used only if AZURE_ANTHROPIC_* are unset).
ANTHROPIC_API_KEY="sk-ant-..."
# Default model for the conversational orchestrator
DIALOG_MODEL="claude-sonnet-4-6"
# Model for intent classification / extraction (same deployment on Azure)
DIALOG_FAST_MODEL="claude-sonnet-4-6"

# Public base URL where the embed app is hosted (used by the loader script)
NEXT_PUBLIC_DIALOG_HOST="http://localhost:3000"

# Admin console auth — set strong values before deploying
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="a-long-random-string"

# Optional: Voyage AI embeddings. When set, KB ingest embeds chunks and search
# uses pgvector cosine; otherwise the platform falls back to Postgres full-text.
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3"

# UAE PASS OIDC (customer sign-in). Staging base: https://stg-id.uaepass.ae ; prod: https://id.uaepass.ae
UAEPASS_BASE="https://stg-id.uaepass.ae"
UAEPASS_CLIENT_ID="your_uaepass_web_client"
UAEPASS_CLIENT_SECRET="your_uaepass_web_secret"
# Must EXACTLY match a callback registered with UAE PASS for this client:
UAEPASS_REDIRECT_URI="https://your-domain/api/uaepass/callback"
UAEPASS_SCOPE="urn:uae:digitalid:profile:general"
UAEPASS_ACR="urn:safelayer:tws:policies:authentication:level:low"

# Local testing only: simulate the UAE PASS round-trip (no registration needed). NEVER set in production.
UAEPASS_MOCK="0"

# EPGL trade-licence registry — the IDEP wrapper in front of MOEc.
# The EPGL assistant turns a UAE PASS sign-in into the customer's own licences.
# We do NOT call integrate.gsb.government.ae ourselves — EPGL's service holds
# those credentials and is the one registered to call the bus. A base URL
# pointing at the government host is refused rather than used.
#   staging: https://api-stg.epgl.ae
MOE_API_BASE_URL=""
MOE_API_CLIENT_ID=""
MOE_API_CLIENT_SECRET=""
# "1" serves a synthetic fixture. Their staging host is real, so staging can
# point at api-stg.epgl.ae rather than mocking.
MOE_API_MOCK="1"
