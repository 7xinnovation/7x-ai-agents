# Neon Postgres (pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
# Default model for the conversational orchestrator
DIALOG_MODEL="claude-opus-4-8"
# Cheaper model for intent classification / extraction
DIALOG_FAST_MODEL="claude-haiku-4-5-20251001"

# Public base URL where the embed app is hosted (used by the loader script)
NEXT_PUBLIC_DIALOG_HOST="http://localhost:3000"

# Admin console auth — set strong values before deploying
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="a-long-random-string"

# Optional: Voyage AI embeddings. When set, KB ingest embeds chunks and search
# uses pgvector cosine; otherwise the platform falls back to Postgres full-text.
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3"

# UAE PASS OIDC (customer sign-in). Staging base: https://stg-id.uaepass.ae ; prod: https://id.uaepass.ae
UAEPASS_BASE="https://stg-id.uaepass.ae"
UAEPASS_CLIENT_ID="your_uaepass_web_client"
UAEPASS_CLIENT_SECRET="your_uaepass_web_secret"
# Must EXACTLY match a callback registered with UAE PASS for this client:
UAEPASS_REDIRECT_URI="https://your-domain/api/uaepass/callback"
UAEPASS_SCOPE="urn:uae:digitalid:profile:general"
UAEPASS_ACR="urn:safelayer:tws:policies:authentication:level:low"
