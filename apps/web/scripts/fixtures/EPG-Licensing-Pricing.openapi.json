{
  "openapi": "3.0.3",
  "info": {
    "title": "EPG Licensing - Pricing API (step 3)",
    "version": "1.1.0",
    "description": "Fee calculation for the delivery-activities regulation. The existing pricing endpoint answers a new-regulation application with the quote the Fee Calculator derives from the licence catalogue: one item per fee line (base fee, per-site / per-locker / per-vehicle components, discounts), available from Draft onwards, re-quoted on every call until the fee is paid, frozen afterwards. Legacy applications keep the previous behaviour. Generated from the NewLaw sandbox catalogue on 2026-10-22T06:29:51Z."
  },
  "servers": [
    {
      "url": "https://epro--newlaw.sandbox.my.salesforce.com",
      "description": "NewLaw sandbox"
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Pricing"
    },
    {
      "name": "Payment"
    }
  ],
  "paths": {
    "/services/oauth2/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get an access token (client credentials)",
        "security": [],
        "description": "Send grant_type=client_credentials with the client id and secret of the External Client App. Use access_token as Bearer token on every other call. Tokens expire after about two hours.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "client_credentials"
                    ],
                    "example": "client_credentials"
                  },
                  "client_id": {
                    "type": "string",
                    "description": "Consumer key of the External Client App",
                    "example": "EPGL_NEWLAW_CLIENT_ID (read from the environment)"
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "Consumer secret of the External Client App",
                    "example": "EPGL_NEWLAW_CLIENT_SECRET (read from the environment)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "instance_url": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "description": "Bearer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/services/apexrest/payment/pricing": {
      "post": {
        "tags": [
          "Pricing"
        ],
        "summary": "Quote an application from the licence catalogue (step 3)",
        "description": "Existing pricing endpoint, extended: for a new-regulation application it answers from Draft onwards with the quote the Fee Calculator derives from the catalogue, one item per fee line (base fee, per-site / per-locker / per-vehicle components, discounts). While the application is still editable and unpaid (Draft, Pending Payment) the quote is recalculated on each call, so a fee changed on the licence product is reflected before payment; once paid the quote is frozen. The amount to pay is the sum of items[].totalAmount. 404 when the application id is unknown or the application is closed (rejected, revoked, closed). Legacy applications keep the previous behaviour of this endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PricingRequest"
              },
              "examples": {
                "byApplicationId": {
                  "summary": "Quote by the applicationId the create response returned (expected per product: CEP30-UAE-SME-DOM 1000 AED; CEP30-UAE-SME-INTL 2000 AED; CEP30-NONUAE-SME-DOM 5000 AED; CEP30-NONUAE-SME-INTL 10000 AED; CEP30-GEN-DOM 20000 AED; CEP30-GEN-INTL 40000 AED; FOODMED 500 AED; INTERMED 5000 AED; LOCKERS 1000 AED; OUTSOURCE no fee)",
                  "value": {
                    "entityId": "EPG Portal",
                    "quotationRequest": {
                      "requestOn": "2026-10-13T09:00:00.000Z",
                      "appIdentifier": {
                        "applicationId": "LR-53330",
                        "serviceId": "LICENSING",
                        "serviceVersion": "1.0",
                        "serviceName": {
                          "en": "Licence application",
                          "ar": "طلب رخصة"
                        },
                        "serviceType": {
                          "code": "NEWREG",
                          "en": "New regulation licence",
                          "ar": "رخصة"
                        },
                        "requestType": "New"
                      },
                      "payType": "PayToSubmit",
                      "infos": []
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or closed application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingRefused"
                }
              }
            }
          }
        }
      }
    },
    "/services/apexrest/paymentNotification": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Payment notification: the website reports the gateway result (existing endpoint)",
        "description": "Called by the website after the gateway confirms the payment of the advice returned by pricing (refInvoiceId). Salesforce marks the advice Paid, moves a new-regulation application from Pending Payment to Submitted, runs the pre-checks and pushes payment.updated / status.changed to the portal endpoint. Before this call the website moves the application to \"Pending Payment\" with the update call (composite with applicationId__c and EPG_Request_Status__c), which raises the advice.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentNotificationRequest"
              },
              "example": {
                "entityId": "EPG Portal",
                "notifyPayment": {
                  "applicationId": "LR-53330",
                  "payment": {
                    "invoiceId": "P14231",
                    "refInvoiceId": "P14231",
                    "paymentId": "GW-PAYMENT-ID",
                    "payOn": "2026-10-27T09:05:00.000Z",
                    "payBy": "Applicant",
                    "payThru": "Online",
                    "paymentMethod": "Card (online)",
                    "paymentStatus": "Paid",
                    "transactions": [
                      {
                        "transactionId": "GW-TXN-ID",
                        "refTransactionId": "GW-TXN-ID",
                        "itemId": "",
                        "beneficiaryId": "EPG",
                        "amount": 20000,
                        "currency": {
                          "en": "AED",
                          "ar": "درهم"
                        }
                      }
                    ]
                  },
                  "message": {
                    "code": "0",
                    "en": "Payment successful",
                    "ar": "تم الدفع"
                  },
                  "infos": []
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted ({ status: 200, desc, message })"
          },
          "400": {
            "description": "Malformed body (payment block must sit inside notifyPayment.payment)"
          },
          "404": {
            "description": "Unknown applicationId"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "access_token from /services/oauth2/token"
      }
    },
    "schemas": {
      "PricingRequest": {
        "type": "object",
        "required": [
          "quotationRequest"
        ],
        "description": "Legacy quotation envelope. Only quotationRequest.appIdentifier.applicationId is needed for a new-regulation application; the other fields are stored for audit.",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "Caller, e.g. \"EPG Portal\""
          },
          "quotationRequest": {
            "type": "object",
            "required": [
              "appIdentifier"
            ],
            "properties": {
              "requestOn": {
                "type": "string",
                "format": "date-time"
              },
              "appIdentifier": {
                "type": "object",
                "required": [
                  "applicationId"
                ],
                "properties": {
                  "applicationId": {
                    "type": "string",
                    "description": "The applicationId returned by the create response (LR-xxxxx, issued by Salesforce)"
                  },
                  "serviceId": {
                    "type": "string"
                  },
                  "serviceVersion": {
                    "type": "string"
                  },
                  "serviceName": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string"
                      },
                      "ar": {
                        "type": "string"
                      }
                    }
                  },
                  "serviceType": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "en": {
                        "type": "string"
                      },
                      "ar": {
                        "type": "string"
                      }
                    }
                  },
                  "requestType": {
                    "type": "string"
                  }
                }
              },
              "invoiceId": {
                "type": "string"
              },
              "payType": {
                "type": "string",
                "description": "e.g. PayToSubmit"
              },
              "dulNumber": {
                "type": "string"
              },
              "subjectIdentifier": {
                "type": "string"
              },
              "subjectType": {
                "type": "string"
              },
              "legalEntityId": {
                "type": "string"
              },
              "infos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "infoKey": {
                      "type": "string"
                    },
                    "infoValue": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PricingResponse": {
        "type": "object",
        "description": "Same shape as the legacy pricing response. For a new-regulation application every item is one fee line of the catalogue quote.",
        "properties": {
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string"
          },
          "desc": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          },
          "quotationResponse": {
            "type": "object",
            "properties": {
              "invoiceId": {
                "type": "string",
                "description": "Payment advice id once raised (Pending Payment), else null"
              },
              "refInvoiceId": {
                "type": "string",
                "description": "Payment advice number"
              },
              "applicationId": {
                "type": "string"
              },
              "pricedBy": {
                "type": "string"
              },
              "quotedOn": {
                "type": "string",
                "format": "date-time"
              },
              "expiredOn": {
                "type": "string",
                "format": "date-time",
                "description": "quotedOn + Fee_Quote_Validity_Days (parameter, default 30)"
              },
              "quotationStatus": {
                "type": "string",
                "enum": [
                  "Approved",
                  "Paid"
                ],
                "description": "Approved = ready to pay; Paid = already settled"
              },
              "items": {
                "type": "array",
                "description": "One per fee line; the sum of totalAmount is the amount to pay. Empty when the product has no application fee.",
                "items": {
                  "type": "object",
                  "properties": {
                    "itemId": {
                      "type": "string",
                      "description": "Id of the fee line (EPG_Request_Item__c), stable across calls while the quote is unchanged"
                    },
                    "itemName": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    },
                    "beneficiaryId": {
                      "type": "string"
                    },
                    "beneficiaryName": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    },
                    "description": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    },
                    "amount": {
                      "type": "number",
                      "description": "Unit amount"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "totalAmount": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PricingRefused": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string"
          },
          "desc": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          }
        }
      },
      "PaymentNotificationRequest": {
        "type": "object",
        "required": [
          "notifyPayment"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "example": "EPG Portal"
          },
          "notifyPayment": {
            "type": "object",
            "required": [
              "applicationId",
              "payment"
            ],
            "properties": {
              "applicationId": {
                "type": "string",
                "description": "The id returned by the create response"
              },
              "payment": {
                "type": "object",
                "required": [
                  "invoiceId",
                  "paymentStatus",
                  "transactions"
                ],
                "properties": {
                  "invoiceId": {
                    "type": "string",
                    "description": "Advice number (refInvoiceId from pricing)"
                  },
                  "refInvoiceId": {
                    "type": "string"
                  },
                  "paymentId": {
                    "type": "string",
                    "description": "Gateway payment id"
                  },
                  "payOn": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "payBy": {
                    "type": "string"
                  },
                  "payThru": {
                    "type": "string"
                  },
                  "paymentMethod": {
                    "type": "string"
                  },
                  "paymentStatus": {
                    "type": "string",
                    "enum": [
                      "Paid"
                    ]
                  },
                  "transactions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "transactionId": {
                          "type": "string"
                        },
                        "refTransactionId": {
                          "type": "string"
                        },
                        "itemId": {
                          "type": "string"
                        },
                        "beneficiaryId": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number"
                        },
                        "currency": {
                          "type": "object",
                          "properties": {
                            "en": {
                              "type": "string"
                            },
                            "ar": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "message": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  },
                  "ar": {
                    "type": "string"
                  }
                }
              },
              "infos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "infoKey": {
                      "type": "string"
                    },
                    "infoValue": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
