  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "access_token from /services/oauth2/token"
      }
    },
    "schemas": {
      "PricingRequest": {
        "type": "object",
        "required": [
          "quotationRequest"
        ],
        "description": "Legacy quotation envelope. Only quotationRequest.appIdentifier.applicationId is needed for a new-regulation application; the other fields are stored for audit.",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "Caller, e.g. \"EPG Portal\""
          },
          "quotationRequest": {
            "type": "object",
            "required": [
              "appIdentifier"
            ],
            "properties": {
              "requestOn": {
                "type": "string",
                "format": "date-time"
              },
              "appIdentifier": {
                "type": "object",
                "required": [
                  "applicationId"
                ],
                "properties": {
                  "applicationId": {
                    "type": "string",
                    "description": "applicationId__c of the application"
                  },
                  "serviceId": {
                    "type": "string"
                  },
                  "serviceVersion": {
                    "type": "string"
                  },
                  "serviceName": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string"
                      },
                      "ar": {
                        "type": "string"
                      }
                    }
                  },
                  "serviceType": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "en": {
                        "type": "string"
                      },
                      "ar": {
                        "type": "string"
                      }
                    }
                  },
                  "requestType": {
                    "type": "string"
                  }
                }
              },
              "invoiceId": {
                "type": "string"
              },
              "payType": {
                "type": "string",
                "description": "e.g. PayToSubmit"
              },
              "dulNumber": {
                "type": "string"
              },
              "subjectIdentifier": {
                "type": "string"
              },
              "subjectType": {
                "type": "string"
              },
              "legalEntityId": {
                "type": "string"
              },
              "infos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "infoKey": {
                      "type": "string"
                    },
                    "infoValue": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PricingResponse": {
        "type": "object",
        "description": "Same shape as the legacy pricing response. For a new-regulation application every item is one fee line of the catalogue quote.",
        "properties": {
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string"
          },
          "desc": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          },
          "quotationResponse": {
            "type": "object",
            "properties": {
              "invoiceId": {
                "type": "string",
                "description": "Payment advice id once raised (Pending Payment), else null"
              },
              "refInvoiceId": {
                "type": "string",
                "description": "Payment advice number"
              },
              "applicationId": {
                "type": "string"
              },
              "pricedBy": {
                "type": "string"
              },
              "quotedOn": {
                "type": "string",
                "format": "date-time"
              },
              "expiredOn": {
                "type": "string",
                "format": "date-time",
                "description": "quotedOn + Fee_Quote_Validity_Days (parameter, default 30)"
              },
              "quotationStatus": {
                "type": "string",
                "enum": [
                  "Approved",
                  "Paid"
                ],
                "description": "Approved = ready to pay; Paid = already settled"
              },
              "items": {
                "type": "array",
                "description": "One per fee line; the sum of totalAmount is the amount to pay. Empty when the product has no application fee.",
                "items": {
                  "type": "object",
                  "properties": {
                    "itemId": {
                      "type": "string",
                      "description": "Id of the fee line (EPG_Request_Item__c), stable across calls while the quote is unchanged"
                    },
                    "itemName": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    },
                    "beneficiaryId": {
                      "type": "string"
                    },
                    "beneficiaryName": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    },
                    "description": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    },
                    "amount": {
                      "type": "number",
                      "description": "Unit amount"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "totalAmount": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "ar": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PricingRefused": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string"
          },
          "desc": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}