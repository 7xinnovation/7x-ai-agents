                      "appIdentifier": {
                        "applicationId": "APP-CEP30-UAE-SME-DOM-ONECALL-01",
                        "serviceId": "LICENSING",
                        "serviceVersion": "1.0",
                        "serviceName": {
                          "en": "Licence application",
                          "ar": "طلب رخصة"
                        },
                        "serviceType": {
                          "code": "NEWREG",
                          "en": "New regulation licence",
                          "ar": "رخصة"
                        },
                        "requestType": "New"
                      },
                      "payType": "PayToSubmit",
                      "infos": []
                    }
                  }
                },
                "CEP30-UAE-SME-INTL": {
                  "summary": "CEP Licence (≤30 kg) — UAE-national-owned SME — Domestic and International (expected 2000 AED)",
